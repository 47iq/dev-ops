pipeline {

	agent {
		docker {
			image 'ivankustarev/debian-openjdk-17-maven-3.9.4-docker'
        }
    }

    stages {
		stage('Checkout') {
			steps {
				checkout scm
            }
        }

        stage('Build') {
			steps {
				sh 'mvn clean install -DskipTests'
            }
        }

        stage('Test') {
			steps {
				sh 'mvn clean test'
            }
        }

        stage('Push Image') {
			steps {
				script {
					sh """
                        echo "$DOCKER_PASSWORD" | docker login --username "$DOCKER_USERNAME" --password-stdin
                        docker build -t ivankustarev/devops-2025-backend:latest .
                        docker push ivankustarev/devops-2025-backend:latest
                        """
                }
            }
        }
    }

    post {
		failure {
			echo 'Build failed!'
        }
    }
}