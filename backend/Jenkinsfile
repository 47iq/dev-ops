pipeline {

	agent {
		docker {
			image 'maven:3.8.5-openjdk-17'
            args '-v $HOME/.m2:/root/.m2'
        }
    }

	agent any

    stages {
		stage('Checkout') {
			steps {
				checkout scm
            }
        }

        stage('Build') {
			steps {
				sh 'mvn clean install -DskipTests'
            }
        }

        stage('Test') {
			steps {
				sh 'mvn clean test'
            }
        }

        stage('Push Image') {
			steps {
				script {
					sh """
                            	echo "$DOCKER_PASSWORD" | docker login --username "$DOCKER_USERNAME" --password-stdin
                               	docker build -t ivankustarev/devops-2025-backend:latest .
                               	docker push ivankustarev/devops-2025-backend:latest
                            """
                }
            }
        }
    }

    post {
		failure {
			echo 'Build failed!'
        }
    }
}